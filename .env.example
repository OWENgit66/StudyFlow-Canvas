# Phase 2: relative SQLite paths resolve from the project root, not cwd.
DATABASE_URL=sqlite:///data/studyflow.db
# Canvas instance origin, e.g. https://your-school.instructure.com (no /api/v1).
# Keep secrets in the root .env file, never in frontend public variables.
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=
CANVAS_TIMEOUT_SECONDS=20
CANVAS_MAX_PAGES=100
CANVAS_MAX_DOWNLOAD_BYTES=104857600
# Legacy configuration, retained for compatibility; new originals use MATERIALS_ROOT.
STORAGE_PATH=data/files
# Human-readable originals. Empty means <project root>/materials.
MATERIALS_ROOT=
# PDF chunks use character counts and never cross pages.
DOCUMENT_CHUNK_SIZE=2000
DOCUMENT_CHUNK_OVERLAP=200
# Optional Phase 5: openai or deepseek; model is used exactly as configured.
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional prose language (e.g. English or Chinese); blank keeps existing behavior.
KNOWLEDGE_OUTPUT_LANGUAGE=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=6000
LLM_BATCH_CHARACTERS=12000
LLM_MAX_BATCHES=20
LLM_MAX_RETRIES=1
## Legacy compatibility only. Leave blank: Semester.is_active and canvas_term_id in SQLite control scope.
SYNC_SEMESTER_ID=
